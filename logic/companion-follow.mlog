# NeizvesnY AI Companion v0.3 - follow with dead zone
# Experimental iOS Mindustry Logic: paste into processor editor.
ubind @flare
uradar player ally any distance 0 1 player
jump 0 equal player null
sensor px player @x
sensor py player @y
sensor ux @unit @x
sensor uy @unit @y
op dst dist ux uy px py
jump 11 lessThan dist 8
ucontrol approach px py 6 0 0
end
ucontrol stop 0 0 0 0 0
end
